{
  "manifest_version": 3,
  "name": "DeciPhish Local Guard",
  "version": "1.1.0",
  "description": "Detect suspected phishing pages with a local DeciPhish model.",
  "permissions": ["tabs", "scripting", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "action": {"default_popup": "popup.html", "default_title": "DeciPhish"}
}
